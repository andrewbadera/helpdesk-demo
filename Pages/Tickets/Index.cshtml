@page
@model helpdesk_demo.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Tickets";
    var statuses = Enum.GetNames<TicketStatus>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">@(Model.IsAgent ? "Ticket queue" : "My tickets")</h1>
        <small class="text-muted">@Model.Tickets.Count ticket(s)</small>
    </div>
    <a class="btn btn-primary" asp-page="/Tickets/Create">
        <i class="bi bi-plus-lg"></i> New ticket
    </a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Subject, reference, or name…" />
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Status</label>
            <select name="StatusFilter" class="form-select">
                <option value="">All statuses</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                }
            </select>
        </div>
        @if (Model.IsAgent)
        {
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" name="MineOnly" value="true" id="mineOnly" checked="@Model.MineOnly" />
                    <label class="form-check-label" for="mineOnly">Assigned to me</label>
                </div>
            </div>
        }
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ref</th>
                    <th>Subject</th>
                    <th>Category</th>
                    @if (Model.IsAgent)
                    {
                        <th>Submitter</th>
                    }
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Tickets)
                {
                    <tr onclick="window.location='@Url.Page("/Tickets/Details", new { id = t.Id })'" style="cursor:pointer">
                        <td class="text-nowrap fw-semibold">@t.Reference</td>
                        <td>@t.Subject</td>
                        <td class="text-nowrap"><span class="badge bg-light text-dark border">@t.CategoryLabel</span></td>
                        @if (Model.IsAgent)
                        {
                            <td class="text-nowrap">@t.SubmitterName</td>
                        }
                        <td><span class="badge @t.PriorityBadgeClass">@t.Priority</span></td>
                        <td><span class="badge @t.StatusBadgeClass">@t.Status</span></td>
                        <td class="text-nowrap text-muted small">@t.UpdatedUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                    </tr>
                }
                @if (!Model.Tickets.Any())
                {
                    <tr>
                        <td colspan="@(Model.IsAgent ? 7 : 6)" class="text-center text-muted py-5">
                            No tickets match your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
