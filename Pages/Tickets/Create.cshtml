@page
@model helpdesk_demo.Pages.Tickets.CreateModel
@{
    ViewData["Title"] = "Submit a Ticket";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-1">Submit a help desk ticket</h1>
        <p class="text-muted">
            Submitting as <strong>@Model.Me.FullName</strong> (@Model.Me.Email).
            The more detail you give, the faster we can help.
        </p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form method="post" class="card card-body">
            <div class="mb-3">
                <label asp-for="Input.Subject" class="form-label"></label>
                <input asp-for="Input.Subject" class="form-control" placeholder="Short summary of the issue" />
                <span asp-validation-for="Input.Subject" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Input.Category" class="form-label"></label>
                    <select asp-for="Input.Category" class="form-select"
                            asp-items="Html.GetEnumSelectList<TicketCategory>()"></select>
                    <div class="form-text">Pick the area that best fits. Not sure? Choose "Other".</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Priority" class="form-label"></label>
                    <select asp-for="Input.Priority" class="form-select"
                            asp-items="Html.GetEnumSelectList<TicketPriority>()"></select>
                    <div class="form-text">Use "Urgent" only for time-sensitive issues like enrollment or benefits deadlines.</div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="6"
                          placeholder="What happened? What have you already tried? Include any error messages or screenshots references."></textarea>
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Submit ticket</button>
                <a asp-page="/Tickets/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>

        <div class="alert alert-info mt-3 small mb-0">
            <strong>Tip:</strong> Many common requests &mdash; password resets, MFA re-enrollment,
            and contact updates &mdash; can be handled instantly on the
            <a asp-page="/SelfService/Index">Self-Service</a> page.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
